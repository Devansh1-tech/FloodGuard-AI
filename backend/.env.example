# =============================================================================
# FloodGuard-AI Backend Environment Configuration Template
# =============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME="FloodGuard AI API"
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-use-a-secure-random-64-char-string
ALLOWED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0"]
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1

# Database Configuration (PostgreSQL + PostGIS)
# For local dev without PostgreSQL, set USE_SQLITE=true to use async SQLite
USE_SQLITE=true
SQLITE_DB_PATH=floodguard_dev.db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=floodguard_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Google Earth Engine Configuration
EE_PROJECT_ID=home-credit-505106
EE_SERVICE_ACCOUNT_KEY=

# Storage Configuration (local | s3 | gcs | azure)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=outputs
STORAGE_S3_BUCKET=floodguard-data
STORAGE_S3_REGION=us-east-1

# Security & Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# Job & Background Execution System
JOB_MAX_CONCURRENT=4
JOB_TIMEOUT_SECONDS=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/backend.log
LOG_ROTATION="50 MB"
LOG_RETENTION="14 days"
