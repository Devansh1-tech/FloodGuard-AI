# =============================================================================
# FloodGuard-AI Environment Configuration
# =============================================================================

# Google Cloud Project ID with Earth Engine API enabled
# Replace with your own project ID if different
EE_PROJECT_ID=home-credit-505106

# Default Area of Interest (AOI) Preset
# Options: nepal_terai_koshi, nepal_terai_chitwan, nepal_terai_full
DEFAULT_AOI=nepal_terai_koshi

# Directory where raster masks, vector polygons, and statistics are exported
OUTPUT_DIR=outputs

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO